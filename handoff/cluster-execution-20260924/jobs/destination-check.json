            {"name": "PYTHONPATH", "value": "/data/users/ali/sgw-01/current-20260924a/source:/data/users/ali/vla_wam/external/RoboLab-pi05-v3-0aef241"},
            {"name": "HOME", "value": "/home/ali"},
            {"name": "USER", "value": "ali"},
            {"name": "LOGNAME", "value": "ali"},
            {"name": "PYTHONDONTWRITEBYTECODE", "value": "1"},
            {"name": "TMPDIR", "value": "/tmp"},
            {"name": "NVIDIA_DRIVER_CAPABILITIES", "value": "compute,utility,graphics,display"},
            {"name": "OMNI_KIT_ACCEPT_EULA", "value": "YES"},
            {"name": "ACCEPT_EULA", "value": "Y"},
            {"name": "VK_ICD_FILENAMES", "value": "/etc/vulkan/icd.d/nvidia_icd.json"},
            {"name": "LD_LIBRARY_PATH", "value": "/data/users/ali/vla_wam/envs/robolab-native-libs-ubuntu2204/usr/lib/x86_64-linux-gnu:/data/users/ali/glvnd/lib:/data/users/ali/vla_wam/envs/fastwam-native-libs/lib:/usr/lib/x86_64-linux-gnu"},
            {"name": "XDG_CACHE_HOME", "value": "/tmp/cache/xdg"},
            {"name": "WARP_CACHE_PATH", "value": "/tmp/cache/warp"},
