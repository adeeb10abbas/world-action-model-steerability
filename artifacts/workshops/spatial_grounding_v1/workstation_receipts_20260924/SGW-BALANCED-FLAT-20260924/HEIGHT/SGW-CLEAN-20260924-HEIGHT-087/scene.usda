    over "rubiks_cube" {
        double3 xformOp:translate = (0.46016965508461, -0.14892264723777773, 0.1624353638291359)
        quatf xformOp:orient = (0.9999990463256836, -0.0009071399690583348, 0.001037940033711493, 8.44117093947716e-05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }
    def Xform "height_reference_support" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        bool physics:kinematicEnabled = true
        double3 xformOp:translate = (0.67, -0.12000000000000001, 0.09122701168060303)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def Cube "geometry" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        ) {
            double size = 1
            double3 xformOp:scale = (0.18, 0.18, 0.08245257645845414)
            uniform token[] xformOpOrder = ["xformOp:scale"]
            color3f[] primvars:displayColor = [(0.55, 0.6, 0.65)]
        }
    }
    def Xform "height_neutral_cube_support" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        bool physics:kinematicEnabled = true
        double3 xformOp:translate = (0.45, -0.12000000000000001, 0.09045305654406548)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def Cube "geometry" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        ) {
            double size = 1
            double3 xformOp:scale = (0.1, 0.1, 0.08090466618537903)
            uniform token[] xformOpOrder = ["xformOp:scale"]
            color3f[] primvars:displayColor = [(0.55, 0.6, 0.65)]
        }
    }
    def Xform "height_upper_support" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        bool physics:kinematicEnabled = true
        double3 xformOp:translate = (0.45, -0.3, 0.11795305654406547)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def Cube "geometry" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        ) {
            double size = 1
            double3 xformOp:scale = (0.16, 0.16, 0.13590466618537902)
            uniform token[] xformOpOrder = ["xformOp:scale"]
            color3f[] primvars:displayColor = [(0.55, 0.6, 0.65)]
        }
    }
    def Xform "height_lower_support" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        bool physics:kinematicEnabled = true
        double3 xformOp:translate = (0.45, 0.059999999999999984, 0.06295305654406548)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def Cube "geometry" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        ) {
            double size = 1
            double3 xformOp:scale = (0.16, 0.16, 0.02590466618537904)
            uniform token[] xformOpOrder = ["xformOp:scale"]
            color3f[] primvars:displayColor = [(0.55, 0.6, 0.65)]
        }
    }

    def Scope "SGWMaterials" {
        def Material "MatteTable" {
            token outputs:surface.connect = </World/SGWMaterials/MatteTable/Surface.outputs:surface>
            def Shader "Surface" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.24, 0.28, 0.32)
                float inputs:roughness = 0.9
                float inputs:metallic = 0
                token outputs:surface
            }
        }
        def Material "MatteFloor" {
            token outputs:surface.connect = </World/SGWMaterials/MatteFloor/Surface.outputs:surface>
            def Shader "Surface" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.64, 0.67)
                float inputs:roughness = 1
                float inputs:metallic = 0
                token outputs:surface
            }
        }
    }
    over "table" (prepend apiSchemas = ["MaterialBindingAPI"]) {
        rel material:binding = </World/SGWMaterials/MatteTable> (
            bindMaterialAs = "strongerThanDescendants"
        )
    }
    over "GroundPlane" (prepend apiSchemas = ["MaterialBindingAPI"]) {
        token visibility = "inherited"
        rel material:binding = </World/SGWMaterials/MatteFloor> (
            bindMaterialAs = "strongerThanDescendants"
        )
    }
}
