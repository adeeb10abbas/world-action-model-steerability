#usda 1.0
(
    defaultPrim = "World"
    subLayers = [@/home/ali/sgw-scene-design-20260923/RoboLab/assets/scenes/rubiks_cube_banana_bowl.usda@]
)

over "World" {
    over "banana" {
        double3 xformOp:translate = (0.79, 0.36, 0.0684281587600708)
        quatf xformOp:orient = (0.9999781250953674, -0.0026648887433111668, -0.006051987875252962, 0.0001454032608307898)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }
    over "bowl" {
        double3 xformOp:translate = (0.67, -0.12000000000000001, 0.16)
        quatf xformOp:orient = (0.9999999403953552, -5.8753543271450326e-05, -0.00032362030469812453, -0.00010501052747713402)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
